model User {
  id                   String             @id @default(uuid(7)) @db.Uuid
  username             String?            @unique
  firstName            String?
  lastName             String?
  name                 String
  email                String             @unique
  emailVerified        Boolean            @default(false)
  image                String?
  resume               String?
  dob                  DateTime?          @db.Date
  about                String?
  location             String?
  twoFactorEnabled     Boolean?           @default(false)
  phoneNumber          String?            @unique
  phoneNumberVerified  Boolean?
  isOnboardingComplete Boolean            @default(false)
  onBoardingStep       Int                @default(0)
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  experienceLevel      ExperienceLevel?
  userType             UserType?
  userSkills           UserSkill[]
  deviceTokens         DeviceToken[]
  learningGoals        LearningGoal[]
  learningStyles       LearningStyle[]
  sessions             Session[]
  accounts             Account[]
  twofactors           TwoFactor[]
  gender               Gender?
  progress             ProblemProgress[]
  role                 UserRole           @default(user)
  socialLinks          UserSocialLinks?
  preferences          UserPreference?
  activity             UserActivity[]
  notifications        Notification[]
  notificationReads    NotificationRead[]

  @@index([username])
  @@map("user")
}

model UserSkill {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String           @db.Uuid
  skillId      String           @db.Uuid
  proficiency  ProficiencyLevel @default(beginner)
  isInterested Boolean          @default(true)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill        Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, skillId])
  @@index([userId])
  @@map("user_skill")
}

model ProblemProgress {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @db.Uuid
  problemId String         @db.Uuid
  status    ProgressStatus @default(not_solved)
  notes     String?
  solvedAt  DateTime?
  favourite Boolean        @default(false)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, problemId])
  @@index([userId, status])
  @@map("problem_progress")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token, expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model TwoFactor {
  id          String   @id @default(uuid(7)) @db.Uuid
  secret      String
  backupCodes String
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean? @default(true)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model UserSocialLinks {
  id       String  @id @default(uuid(7)) @db.Uuid
  userId   String  @unique @db.Uuid
  github   String?
  linkedin String?
  twitter  String?
  website  String?
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_social_links")
}

model DeviceToken {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @db.Uuid
  fid        String         @unique
  platform   DevicePlatform @default(web)
  userAgent  String?
  lastUsedAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_token")
}

model UserPreference {
  id                 String            @id @default(uuid(7)) @db.Uuid
  userId             String            @unique @db.Uuid
  defaultLanguage    String            @default("cpp")
  theme              String            @default("dark")
  editorFontSize     Int               @default(14)
  tabSize            Int               @default(4)
  autosave           Boolean           @default(true)
  emailNotifications Boolean           @default(false)
  pushNotifications  Boolean           @default(false)
  smsNotifications   Boolean           @default(false)
  profileVisibility  ProfileVisibility @default(public)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preference")
}

model UserActivity {
  id     String   @id @default(uuid(7)) @db.Uuid
  userId String   @db.Uuid
  date   DateTime @db.Date
  count  Int      @default(1)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("user_activity")
}

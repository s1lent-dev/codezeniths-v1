model Skill {
  id                    String                 @id @default(uuid(7)) @db.Uuid
  title                 String
  slug                  String                 @unique
  moduleId              String                 @db.Uuid
  module                Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  userSkills            UserSkill[]

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@map("skill")
}

  // usedExperienceSkills  UsedExperienceSkill[]
  // usedProjectSkills     UsedProjectSkill[]
  // usedAchievementSkills UsedAchievementSkill[]
  // usedCertificateSkills UsedCertificateSkill[]

model UserSkill {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String           @db.Uuid
  skillId      String           @db.Uuid
  proficiency  ProficiencyLevel @default(beginner)
  isInterested Boolean          @default(true)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill        Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, skillId])
  @@index([userId])
  @@map("user_skill")
}

model Problem {
  id             String            @id @default(uuid(7)) @db.Uuid
  topicId        String            @db.Uuid
  topic          Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title          String
  slug           String            @unique
  difficulty     Difficulty
  articleUrl     String?
  problemUrl     String?
  favouriteCount Int               @default(0)
  order          Int               @default(0)
  tags           ProblemTag[]
  progresses     ProblemProgress[]
  playlistItems  PlaylistItem[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("problem")
}

model ProblemProgress {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @db.Uuid
  problemId String         @db.Uuid
  status    ProgressStatus @default(not_solved)
  revisit   Boolean        @default(false)
  favourite Boolean        @default(false)
  notes     String?
  solvedAt  DateTime?
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, problemId])
  @@index([userId, status])
  @@index([userId, revisit])
  @@index([userId, status, solvedAt(sort: Desc)])
  @@map("problem_progress")
}

model ProblemTag {
  id        String  @id @default(uuid(7)) @db.Uuid
  problemId String  @db.Uuid
  tagId     String  @db.Uuid
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([problemId, tagId])
  @@index([problemId, tagId])
  @@map("problem_tag")
}
